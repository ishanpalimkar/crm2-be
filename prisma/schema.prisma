datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

model User {
  id                   Int                   @id @default(autoincrement())
  userId               String
  name                 String
  email                String?
  mobileNumber         String?
  emails               Email[]
  addresses            Address[]
  mobileNumbers        MobileNumber[]
  teacher              Teacher?
  volunteer            Volunteer?
  programParticipants  ProgramParticipant[]
  programs             Program[]             @relation("ProgramOrganisers")
  participantResources ParticipantResource[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model Email {
  id        Int      @id @default(autoincrement())
  email     String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  userId    Int

  @@index([userId])
}

model MobileNumber {
  id           Int      @id @default(autoincrement())
  mobileNumber String
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id])
  userId       Int

  @@index([userId])
}

model Address {
  id        Int      @id @default(autoincrement())
  address   String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
  userId    Int

  @@index([userId])
}

model Volunteer {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  user      User      @relation(fields: [userId], references: [id])
  programs  Program[] @relation("VolunteerPrograms")
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Teacher {
  id               Int                  @id @default(autoincrement())
  userId           Int                  @unique
  user             User                 @relation(fields: [userId], references: [id])
  teacherCode      String
  eligibility      TeacherEligibility[]
  status           String
  isActive         Boolean              @default(true)
  isSearchable     Boolean              @default(true)
  isOnboarded      Boolean              @default(false)
  programs         Program[]            @relation(name: "TeacherPrograms")
  coTaughtPrograms Program[]            @relation(name: "CoTaughtPrograms")
  leads            Lead[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
}

model TeacherEligibility {
  id        Int         @id @default(autoincrement())
  teacherId Int
  teacher   Teacher     @relation(fields: [teacherId], references: [id])
  programId Int
  program   ProgramType @relation(fields: [programId], references: [id])
  metaData  Json
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([teacherId])
  @@index([programId])
}

model ProgramType {
  id                 Int                  @id @default(autoincrement())
  name               String
  description        String?
  // refer er diagram for more details
  // honorarium calculations table (changes based on seniority, region, venue type, etc)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  metaData           Json
  isActive           Boolean              @default(true)
  activeUntil        DateTime?
  teacherEligibility TeacherEligibility[]
  preRequisites      Json?
  programs           Program[]
  resources          ProgramResource[]
  leads              Lead[]
  feeStructure       Json
}

model Center {
  id            Int       @id @default(autoincrement())
  name          String
  centerType    String // ashram, TOK, GyanKshetra, etc
  description   String?
  address       String?
  city          String?
  state         String?
  country       String?
  pincode       String?
  geoLocation   Json?
  contactNumber String?
  email         String?
  capacity      Int?
  isActive      Boolean   @default(true)
  createdBy     Json
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  metaData      Json
  programs      Program[]
}

model Program {
  id                        Int                  @id @default(autoincrement())
  programTypeId             Int
  programType               ProgramType          @relation(fields: [programTypeId], references: [id])
  centerId                  Int?
  center                    Center?              @relation(fields: [centerId], references: [id])
  timing                    Json // define default
  tags                      Json                 @default("[]")
  registrationCloseDateTime DateTime?
  registrationOpenDateTime  DateTime? // think
  scheduled                 Boolean              @default(false) // think
  isActive                  Boolean              @default(true)
  isSearchable              Boolean              @default(true)
  shortUrl                  String?
  primaryTeacherId          Int
  primaryTeacher            Teacher              @relation(fields: [primaryTeacherId], references: [id], name: "TeacherPrograms")
  coTeachers                Teacher[]            @relation(name: "CoTaughtPrograms")
  participants              ProgramParticipant[]
  leads                     Lead[]
  feeStructure              Json // Early bird pricing, region based pricing, etc [{type: default, price: 2500}]
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  status                    String               @default("draft") // draft, announced, in-progress, completed, cancelled, postponed
  crfStatus                 String               @default("crf-not-submitted") // crf-submitted, crf-approved, crf-rejected
  metaData                  Json
  volunteers                Volunteer[]          @relation("VolunteerPrograms")
  organisers                User[]               @relation("ProgramOrganisers")

  @@index([primaryTeacherId])
  @@index([centerId])
  @@index([programTypeId])
}

model Lead {
  id           Int      @id @default(autoincrement())
  name         String
  email        String?
  mobileNumber String?
  programId    Int?
  program      Program? @relation(fields: [programId], references: [id])

  programTypes ProgramType[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  metaData     Json?
  teacherId    Int?
  teacher      Teacher?      @relation(fields: [teacherId], references: [id])

  @@index([programId])
  @@index([teacherId])
}

model ProgramParticipant {
  id             Int          @id @default(autoincrement())
  programId      Int          @unique
  program        Program      @relation(fields: [programId], references: [id])
  registrationId Int          @unique
  registration   Registration @relation(fields: [registrationId], references: [id], name: "ProgramParticipants")
  userId         Int
  user           User         @relation(fields: [userId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  metaData       Json?

  @@index([programId])
  @@index([registrationId])
  @@index([userId])
}

model Registration {
  id                   Int                 @id @default(autoincrement())
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  programParticipant   ProgramParticipant? @relation(name: "ProgramParticipants")
  metaData             Json?
  status               String              @default("confirmed") // booked, pending, confirmed, cancelled, refunded, failed
  registrationDateTime DateTime            @default(now())
  registrationDetails  Json?
}

model ProgramResource {
  id            Int         @id @default(autoincrement())
  programType   ProgramType @relation(fields: [programTypeId], references: [id])
  programTypeId Int
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  metaData      Json?

  @@index([programTypeId])
}

model ParticipantResource {
  id         Int      @id @default(autoincrement())
  user       User     @relation(fields: [userId], references: [id])
  userId     Int
  resource   Resource @relation(fields: [resourceId], references: [id])
  resourceId Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  metaData   Json?

  @@index([userId])
  @@index([resourceId])
}

model Resource {
  id                   Int                   @id @default(autoincrement())
  name                 String
  description          String?
  url                  String?
  type                 String? // pdf, video, audio, image, link, etc
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  metaData             Json?
  participantResources ParticipantResource[]
}

